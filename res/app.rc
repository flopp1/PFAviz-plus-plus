// PFAviz++ resource script (UTF-8). Trimmed port of the original PianoFromAbove.rc.
#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 0, 0, 234, 169
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PFAviz++"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC,"Static",SS_WHITERECT,0,1,234,147
    CONTROL         "",IDC_PICTURE,"Static",SS_BITMAP,0,0,15,13
    LTEXT           "PFAviz++\nBased on Piano From Above 1.1.0\n©2010 Brian Pantano",IDC_STATIC,88,7,139,29
    LTEXT           "Enjoy",IDC_LICENSE,88,40,139,12
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,1,147,233,1
    DEFPUSHBUTTON   "OK",IDOK,177,151,50,14
END

IDD_PP_KEYS DIALOGEX 0, 0, 460, 280
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Property Page"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    GROUPBOX        "Keys",IDC_STATIC,7,7,218,96
    CONTROL         "Show all &128 keys",IDC_SHOWALL128KEYS,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,13,20,200,10
    CONTROL         "Show &256 keys",IDC_SHOWALL256KEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,13,32,200,10
    CONTROL         "Show all &88 keys",IDC_SHOWALLKEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,13,44,200,10
    CONTROL         "Show the song's &keys",IDC_SHOWSONGKEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,13,56,200,10
    CONTROL         "Show ke&ys:",IDC_SHOWCUSTOMKEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,13,68,50,10
    COMBOBOX        IDC_FIRSTKEY,65,66,40,120,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "through",IDC_THROUGH,110,68,28,8,WS_DISABLED
    COMBOBOX        IDC_LASTKEY,140,66,40,120,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&31-EDO keyboard layout (256 key mode only)",IDC_EDO31KEYS,"Button",BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP,13,85,206,10
    GROUPBOX        "Note drawing",IDC_STATIC,235,7,218,96
    CONTROL         "&Clean drawing: leaves out quirks of the original's note drawing",IDC_CLEAN,"Button",BS_3STATE | BS_MULTILINE | WS_TABSTOP,241,20,206,20
    PUSHBUTTON      "Advanc&ed...",IDC_CLEANADV,241,44,60,14
    CONTROL         "Hide the key dividers and measure &lines",IDC_HIDELINES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,241,66,206,10
