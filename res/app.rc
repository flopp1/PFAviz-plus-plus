    CONTROL         "T&ime",IDC_STAT_FIRST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,19,70,10
    CONTROL         "&Frame rate",1401,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,19,70,10
    CONTROL         "Sco&re",1402,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,167,19,70,10
    GROUPBOX        "Notes (counted at load: reopen a song after enabling)",IDC_STATIC,7,39,238,27
    CONTROL         "Notes passe&d",1403,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,51,70,10
    CONTROL         "&NPS",1404,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,51,70,10
    CONTROL         "Pol&yphony",1405,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,167,51,70,10
    GROUPBOX        "Synth (needs a MIDI output)",IDC_STATIC,7,71,238,41
    CONTROL         "Messages &sent",1406,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,83,70,10
    CONTROL         "S&kipped",1407,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,83,70,10
    CONTROL         "&Collapsed",1408,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,167,83,70,10
    CONTROL         "&Lag",1409,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,97,70,10
    CONTROL         "Skipping &threshold",1410,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,97,75,10
    GROUPBOX        "Playback pipeline (needs a MIDI output)",IDC_STATIC,7,117,238,41
    CONTROL         "&Messages decoded",1415,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,129,70,10
    CONTROL         "Decoder &busy",1416,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,129,70,10
    CONTROL         "Sender b&usy",1417,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,167,129,70,10
    CONTROL         "Rin&g fill",1418,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,143,70,10
    CONTROL         "Send cost",1419,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,143,70,10
    GROUPBOX        "Frame time (average / maximum ms)",IDC_STATIC,7,163,238,41
    CONTROL         "Ot&her",1411,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,175,70,10
    CONTROL         "N&otes",1412,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,90,175,70,10
    CONTROL         "Sc&ene",1413,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,167,175,70,10
    CONTROL         "&Present",1414,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,189,70,10
    PUSHBUTTON      "&All",IDC_STATS_ALL,7,221,40,14
    PUSHBUTTON      "None",IDC_STATS_NONE,51,221,40,14
    DEFPUSHBUTTON   "OK",IDOK,141,221,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,195,221,50,14
END

