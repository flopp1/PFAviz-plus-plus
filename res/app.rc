// PFAviz++ resource script (UTF-8). Trimmed port of the original PianoFromAbove.rc.
#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 0, 0, 234, 169
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PFAviz++"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC,"Static",SS_WHITERECT,0,1,234,147
    CONTROL         "",IDC_PICTURE,"Static",SS_BITMAP,0,0,15,13
    LTEXT           "PFAviz++\nBased on Piano From Above 1.1.0\n©2010 Brian Pantano",IDC_STATIC,88,7,139,29
    LTEXT           "Enjoy",IDC_LICENSE,88,40,139,12
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,1,147,233,1
    DEFPUSHBUTTON   "OK",IDOK,177,151,50,14
END

IDD_PP1_VISUAL DIALOGEX 0, 0, 302, 212
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_BORDER
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
