    CONTROL         "",IDC_COLOR2,"Button",BS_OWNERDRAW,68,94,13,12,WS_EX_CLIENTEDGE
    CONTROL         "",IDC_COLOR3,"Button",BS_OWNERDRAW,83,94,13,12,WS_EX_CLIENTEDGE
    CONTROL         "",IDC_COLOR4,"Button",BS_OWNERDRAW,98,94,13,12,WS_EX_CLIENTEDGE
    CONTROL         "",IDC_COLOR5,"Button",BS_OWNERDRAW,113,94,13,12,WS_EX_CLIENTEDGE
    CONTROL         "",IDC_COLOR6,"Button",BS_OWNERDRAW,128,94,13,12,WS_EX_CLIENTEDGE
    LTEXT           "Background color:",IDC_STATIC,155,96,58,8
