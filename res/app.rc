    LTEXT           "A&udio file (WAV, FLAC, ...; empty: a silent video):",IDC_STATIC,13,213,220,8
    EDITTEXT        IDC_VID_AUDIO,13,224,218,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Bro&wse...",IDC_VID_AUDIOBROWSE,236,224,50,14
    CONTROL         "&Align its first sound with the first note",IDC_VID_AUDIOALIGN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,246,150,10
    LTEXT           "Then &move by:",IDC_STATIC,168,247,50,8
    EDITTEXT        IDC_VID_AUDIOOFFSET,220,244,40,14,ES_AUTOHSCROLL
    LTEXT           "ms",IDC_STATIC,264,247,20,8
    DEFPUSHBUTTON   "&Start rendering",IDOK,7,271,80,14
    PUSHBUTTON      "Close",IDCANCEL,243,271,50,14
END

