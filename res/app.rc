    LTEXT           "&Left and right arrows advance by:",IDC_STATIC,13,20,110,8
    EDITTEXT        IDC_LRARROWS,125,18,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_LRARROWSSPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,153,18,11,14
    LTEXT           "seconds",IDC_STATIC,168,20,27,8
    LTEXT           "&Up and down arrows speed up by:",IDC_STATIC,13,41,111,8
    EDITTEXT        IDC_UDARROWS,125,39,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_UDARROWSSPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,153,39,11,14
    LTEXT           "percent",IDC_STATIC,168,41,26,8
    LTEXT           "Shift+up/down change &notes by:",IDC_STATIC,13,62,111,8
    EDITTEXT        IDC_NSARROWS,125,60,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_NSARROWSSPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,153,60,11,14
    LTEXT           "percent",IDC_STATIC,168,62,26,8
    GROUPBOX        "Playback",IDC_STATIC,7,87,288,30
    CONTROL         "Start songs &paused after loading",IDC_STARTPAUSED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,100,200,10
END

IDD_PP5_PERFORMANCE DIALOGEX 0, 0, 300, 360
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Property Page"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    GROUPBOX        "Loading and drawing",IDC_STATIC,7,7,286,116
    LTEXT           "&Threads:",IDC_STATIC,13,21,60,8
    EDITTEXT        IDC_PERF_THREADS,80,19,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_PERF_THREADSNOTE,114,21,174,8
    CONTROL         "Show loading &statistics after a file is loaded",IDC_PERF_LOADSTATS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,37,200,10
    CONTROL         "C&ompact visual store (less memory, slightly slower drawing)",IDC_PERF_COMPACT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,51,270,10
    LTEXT           "&Block cache:",IDC_STATIC,13,67,60,8
    EDITTEXT        IDC_PERF_CACHEMB,80,65,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "MB of decoded notes (compact store)",IDC_STATIC,124,67,164,8
    CONTROL         "LOD c&ache (faster drawing of dense songs, built in the background)",IDC_PERF_LOD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,82,270,10
    CONTROL         "End weird notes at their &first note-off (keep the first pairing)",IDC_PERF_IGNOREWEIRD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,96,270,10
    CONTROL         "&GPU instancing for notes (less CPU work per note; not pixel-exact)",IDC_PERF_INSTANCING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,110,270,10
    GROUPBOX        "Playback",IDC_STATIC,7,128,286,194
    LTEXT           "&Decoding threads:",IDC_STATIC,13,142,64,8
    EDITTEXT        IDC_PERF_PLAYTHREADS,80,140,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_PERF_PLAYTHREADSNOTE,114,142,174,8
    CONTROL         "Prefer &KDMAPI (OmniMIDI) when it is available",IDC_PERF_KDMAPI,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,157,200,10
    CONTROL         "Send to KDMAPI in lo&ng messages of up to",IDC_PERF_LONGSENDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,171,146,10
    EDITTEXT        IDC_PERF_LONGBYTES,173,169,50,13,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "bytes (raw MIDI)",IDC_STATIC,227,171,61,8
    CONTROL         "S&kip quiet notes while the synth lags (by velocity; off sends every event)",IDC_PERF_SKIPPING,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,186,275,10
    LTEXT           "Start a&bove:",IDC_STATIC,25,204,50,8
    EDITTEXT        IDC_PERF_MAXLAG,80,202,40,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_PERF_MAXLAGSPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS,108,202,11,14
    LTEXT           "ms of lag (all notes skipped at 4 times this lag)",IDC_STATIC,124,204,164,8
    CONTROL         "Always skip notes &quieter than velocity",IDC_PERF_VELFLOOR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,222,143,10
    EDITTEXT        IDC_PERF_MINVEL,158,220,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "(1-128; their offs too)",IDC_STATIC,192,222,96,8
    CONTROL         "Collaps&e stacked notes (one voice per channel, key and tick)",IDC_PERF_COLLAPSE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,238,275,10
    CONTROL         "Li&mit sending to",IDC_PERF_SENDLIMIT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,256,66,10
    EDITTEXT        IDC_PERF_MAXSENDS,80,254,50,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "messages/s (quietest notes skipped first)",IDC_STATIC,134,256,154,8
    CONTROL         "Apply 31-EDO tuning",IDC_PERF_TUNING31,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,274,275,10
    CONTROL         "Use pitch-bends tuning instead of MTS for compatibility. Broken.",IDC_PERF_TUNING31BEND,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,289,263,10
    LTEXT           "Applies at once. Off: keys past 127 are shown, not played.",IDC_STATIC,25,305,263,8
    GROUPBOX        "Display",IDC_STATIC,7,327,286,28
    CONTROL         "&Limit frame rate",IDC_LIMITFPS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,340,100,10
    PUSHBUTTON      "Render &video...",IDC_PERF_VIDEO,120,337,80,14
END

IDD_STATS DIALOGEX 0, 0, 300, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Statistics"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Lines, top to bottom (checked lines are shown):",IDC_STATIC,7,7,180,8
    CONTROL         "",IDC_STATS_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,7,18,182,206
    PUSHBUTTON      "Move &up",IDC_STATS_UP,195,18,98,14
    PUSHBUTTON      "Move &down",IDC_STATS_DOWN,195,35,98,14
    PUSHBUTTON      "&Reset order",IDC_STATS_RESETORDER,195,52,98,14
    GROUPBOX        "Whole sections",IDC_STATIC,195,72,98,86
    CONTROL         "&General",IDC_STATS_SECTION0,"Button",BS_3STATE | WS_TABSTOP,201,84,88,10
    CONTROL         "&Notes",1431,"Button",BS_3STATE | WS_TABSTOP,201,98,88,10
    CONTROL         "&Synth",1432,"Button",BS_3STATE | WS_TABSTOP,201,112,88,10
    CONTROL         "&Playback pipeline",1433,"Button",BS_3STATE | WS_TABSTOP,201,126,88,10
    CONTROL         "&Frame time",1434,"Button",BS_3STATE | WS_TABSTOP,201,140,88,10
    PUSHBUTTON      "&All",IDC_STATS_ALL,195,164,47,14
    PUSHBUTTON      "N&one",IDC_STATS_NONE,246,164,47,14
    LTEXT           "Notes lines are counted at load (reopen the song). Synth and pipeline lines need a MIDI output; voices and synth CPU need KDMAPI.",IDC_STATIC,195,183,98,46
    DEFPUSHBUTTON   "OK",IDOK,189,231,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,243,231,50,14
END

IDD_VIDEOEXPORT DIALOGEX 0, 0, 300, 292
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
