    EDITTEXT        IDC_VID_FPS,80,111,32,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "fps (1-240)",IDC_STATIC,117,113,80,8
    LTEXT           "&Quality:",IDC_STATIC,13,132,66,8
    EDITTEXT        IDC_VID_CRF,80,130,32,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "0-51, lower is better (0: lossless in software)",IDC_STATIC,117,132,170,8
    LTEXT           "Encoder &preset:",IDC_STATIC,13,151,64,8
    COMBOBOX        IDC_VID_PRESET,80,149,72,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Show the &stats area (top right)",IDC_VID_STATS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,160,151,126,10
    LTEXT           "The whole song is rendered off-screen at this size (with the current view and note speed) and encoded by ffmpeg, from the PATH or the current folder. The encoder is tried at this size first, so its own limits apply.",IDC_STATIC,13,167,274,26
