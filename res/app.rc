// PFAviz++ resource script (UTF-8). Trimmed port of the original PianoFromAbove.rc.
#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

1 RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_ABOUT DIALOGEX 0, 0, 234, 169
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PFAviz++"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_STATIC,"Static",SS_WHITERECT,0,1,234,147
    CONTROL         "",IDC_PICTURE,"Static",SS_BITMAP,0,0,15,13
    LTEXT           "PFAviz++\nBased on Piano From Above 1.1.0\n©2010 Brian Pantano",IDC_STATIC,88,7,139,29
    LTEXT           "Enjoy",IDC_LICENSE,88,40,139,12
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,1,147,233,1
    DEFPUSHBUTTON   "OK",IDOK,177,151,50,14
END

IDD_PP1_VISUAL DIALOGEX 0, 0, 302, 338
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_BORDER
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    LTEXT           "Keys to display:",IDC_STATIC,7,7,52,8
    CONTROL         "Show all &128 keys",IDC_SHOWALL128KEYS,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,7,19,73,10
    CONTROL         "Show &256 keys",IDC_SHOWALL256KEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,90,19,73,10
    CONTROL         "&Show all 88 keys",IDC_SHOWALLKEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,7,33,69,10
    CONTROL         "S&how song keys",IDC_SHOWSONGKEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,7,47,67,10
    CONTROL         "Show &keys:",IDC_SHOWCUSTOMKEYS,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,7,62,53,10
    COMBOBOX        IDC_FIRSTKEY,61,61,32,120,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "through",IDC_THROUGH,101,63,26,8,WS_DISABLED
    COMBOBOX        IDC_LASTKEY,135,61,32,120,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    CONTROL         "&Don't hide controls toolbar in full screen mode",IDC_SHOWCONTROLS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,78,161,10
    CONTROL         "Hide the toolbar's speed bo&xes",IDC_HIDESPEEDBOXES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,175,78,120,10
    LTEXT           "Track colors:",IDC_STATIC,7,96,44,8
    EDITTEXT        IDC_COLORCOUNT,53,94,30,13,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "",IDC_COLORCOUNTSPIN,"msctls_updown32",UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_SETBUDDYINT | UDS_NOTHOUSANDS,83,94,11,13
    CONTROL         "Loop &colors",IDC_LOOPCOLORS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,99,95,50,10
    CONTROL         "",IDC_PALETTE,"Button",BS_OWNERDRAW | WS_TABSTOP,7,111,288,32
    LTEXT           "Background color:",IDC_STATIC,155,96,58,8
    CONTROL         "",IDC_BKGCOLOR,"Button",BS_OWNERDRAW,217,94,13,12,WS_EX_CLIENTEDGE
    LTEXT           "Stats box:",IDC_STATIC,7,149,42,8
    PUSHBUTTON      "S&tatistics...",IDC_STATSBOX,53,146,60,14
    LTEXT           "",IDC_STATSCOUNT,119,149,120,8
    LTEXT           "&Window size:",IDC_STATIC,7,169,44,8
    EDITTEXT        IDC_WINWIDTH,53,167,34,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "x",IDC_STATIC,91,169,8,8
    EDITTEXT        IDC_WINHEIGHT,101,167,34,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WINSIZEMAX,141,169,155,8
    GROUPBOX        "Background",IDC_STATIC,7,187,288,74
    CONTROL         "Show a background &image (over the background color, in the notes area):",IDC_BKGON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,199,276,10
    EDITTEXT        IDC_BKGIMAGE,13,212,222,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Br&owse...",IDC_BKGBROWSE,239,212,50,14
    LTEXT           "&Fit:",IDC_STATIC,13,232,14,8
    COMBOBOX        IDC_BKGFIT,30,230,74,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "O&pacity:",IDC_STATIC,114,232,30,8
    EDITTEXT        IDC_BKGOPACITY,146,230,28,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%",IDC_STATIC,178,232,10,8
    CONTROL         "Hide the key dividers and measure &lines",IDC_HIDELINES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,247,276,10
    GROUPBOX        "Clean drawing (leaves out quirks of the original's note drawing)",IDC_STATIC,7,265,288,52
    CONTROL         "Draw every note at least one pixel t&all",IDC_CLEAN_MINHEIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,277,276,10
    CONTROL         "Keep short notes on screen until they reach the key&board",IDC_CLEAN_KEEPBOTTOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,289,276,10
    CONTROL         "Round note &edges evenly, so lower layers never show past notes above",IDC_CLEAN_EDGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,301,276,10
    PUSHBUTTON      "&Restore Defaults",IDC_RESTOREDEFAULTS,226,321,69,14
END

IDD_PP2_AUDIO DIALOGEX 0, 0, 300, 212
