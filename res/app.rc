    LTEXT           "x",IDC_STATIC,91,253,8,8
    EDITTEXT        IDC_WINHEIGHT,101,251,34,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "",IDC_WINSIZEMAX,141,253,155,8
    GROUPBOX        "Background",IDC_STATIC,302,7,288,74
    CONTROL         "Show a background &image (over the background color, in the notes area):",IDC_BKGON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,19,276,10
    EDITTEXT        IDC_BKGIMAGE,308,32,222,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Br&owse...",IDC_BKGBROWSE,534,32,50,14
    LTEXT           "&Fit:",IDC_STATIC,308,52,14,8
    COMBOBOX        IDC_BKGFIT,325,50,74,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "O&pacity:",IDC_STATIC,409,52,30,8
    EDITTEXT        IDC_BKGOPACITY,441,50,28,14,ES_AUTOHSCROLL | ES_NUMBER
