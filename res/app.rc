    LTEXT           "",IDC_STATSCOUNT,119,167,66,8
    PUSHBUTTON      "&Graphs...",IDC_GRAPHBTN,189,164,52,14
    CONTROL         "Show",IDC_GRAPHON,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,246,166,40,10
    LTEXT           "Si&ze:",IDC_STATIC,53,185,18,8
    EDITTEXT        IDC_STATSSIZE,75,182,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "x",IDC_STATIC,108,185,8,8
    EDITTEXT        IDC_STATSHEIGHT,116,182,30,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "pixels, scale with resol&ution",IDC_STATSSCALED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,152,184,145,10
    LTEXT           "Cor&ner:",IDC_STATIC,53,201,26,8
    COMBOBOX        IDC_STATSCORNER,81,198,62,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Font:",IDC_STATIC,152,201,20,8
    COMBOBOX        IDC_STATSFONT,174,198,121,200,CBS_DROPDOWN | CBS_SORT | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Height b&y font size:",IDC_STATSFONTSET,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,53,216,78,10
    EDITTEXT        IDC_STATSFONTPX,132,214,26,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",IDC_STATIC,161,216,10,8
