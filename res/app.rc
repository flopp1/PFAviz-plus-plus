    LTEXT           "&Codec:",IDC_STATIC,134,53,26,8
    COMBOBOX        IDC_VID_CODEC,162,51,124,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "E&ncoder:",IDC_STATIC,13,72,40,8
    COMBOBOX        IDC_VID_ENCODER,56,70,90,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_VID_ENCNOTE,152,72,134,8
    CONTROL         "Use &window size",IDC_VID_WINDOWSIZE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,92,70,10
    LTEXT           "&Resolution:",IDC_STATIC,88,93,38,8
    COMBOBOX        IDC_VID_RES,128,90,90,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
