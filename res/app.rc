    COMBOBOX        IDC_LOOPCOLORS,90,120,60,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Click a colour to change it.",IDC_STATIC,158,122,150,8
    CONTROL         "",IDC_PALETTE,"Button",BS_OWNERDRAW | WS_TABSTOP,13,138,434,36
    LTEXT           "&Palettes:",IDC_STATIC,13,183,32,8
    COMBOBOX        IDC_PALETTES,47,181,130,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Save as...",IDC_PALETTESAVE,183,180,48,14
    PUSHBUTTON      "&Delete",IDC_PALETTEDELETE,235,180,44,14
    PUSHBUTTON      "&New",IDC_PALETTENEW,283,180,44,14
    PUSHBUTTON      "&Restore Defaults",IDC_RESTOREDEFAULTS,384,259,69,14
END

