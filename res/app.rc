    LTEXT           "",IDC_KDMAPISTATUS,13,101,571,16
    CONTROL         "&Use KDMAPI when it is available, instead of the device above",IDC_PERF_KDMAPI,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,120,300,10
    CONTROL         "Send in lo&ng messages (raw MIDI, one per batch of events)",IDC_PERF_LONGSENDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,25,134,300,10
    GROUPBOX        "31-EDO",IDC_STATIC,7,154,583,54
    CONTROL         "Show 256 keys in the &31-EDO layout (31 keys an octave; with Visual > Show 256 keys)",IDC_EDO31KEYS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,166,400,10
    CONTROL         "Apply 31-EDO &tuning",IDC_PERF_TUNING31,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,180,100,10
