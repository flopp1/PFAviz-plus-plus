    CONTROL         "Hide the key dividers and measure &lines",IDC_HIDELINES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,67,276,10
    GROUPBOX        "Clean drawing (leaves out quirks of the original's note drawing)",IDC_STATIC,302,85,288,52
    CONTROL         "Draw every note at least one pixel t&all",IDC_CLEAN_MINHEIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,97,276,10
    CONTROL         "Keep short notes on screen from the top edge until they reach the key&board",IDC_CLEAN_KEEPBOTTOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,109,276,10
    CONTROL         "Round note &edges evenly, so lower layers never show past notes above",IDC_CLEAN_EDGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,121,276,10
    GROUPBOX        "Interface",IDC_STATIC,302,141,288,32
    LTEXT           "Light or dark the&me:",IDC_STATIC,308,156,70,8
    COMBOBOX        IDC_THEME,380,154,90,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Timing",IDC_STATIC,302,177,288,83
    CONTROL         "Tic&k-based: notes spaced by ticks (a quarter note is 0.5 s at any tempo)",IDC_TICKBASED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,188,276,10
    CONTROL         "Simulate the original PFA's la&g (frame rate, freezes, audio bursts)",IDC_PFALAG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,308,200,276,10
    LTEXT           "Its L2:",IDC_STATIC,320,216,22,8
    EDITTEXT        IDC_PFAL2,344,214,36,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "L3:",IDC_STATIC,384,216,12,8
    EDITTEXT        IDC_PFAL3,398,214,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "KB; a MIDI message:",IDC_PFACPU,442,216,68,8
    EDITTEXT        IDC_PFASEND,512,214,30,14,ES_AUTOHSCROLL
    LTEXT           "µs",IDC_STATIC,546,216,12,8
    LTEXT           "Its CPU speed:",IDC_STATIC,320,232,50,8
    EDITTEXT        IDC_PFASPEED,372,230,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "% of this computer's",IDC_PFABENCH,406,232,180,8
    CONTROL         "Statistics follo&w how far its Logic has played (off: its last drawn frame)",IDC_PFASTATS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,320,246,264,10
    PUSHBUTTON      "&Restore Defaults",IDC_RESTOREDEFAULTS,521,264,69,14
END

IDD_PP2_AUDIO DIALOGEX 0, 0, 597, 212
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Property Page"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    LTEXT           "MIDI &output device:",IDC_STATIC,7,7,65,8
