/////////////////////////////////////////////////////////////////////////////
// Menus

IDM_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Play Song...\tCtrl+O",       ID_FILE_PLAYSONG
        MENUITEM "&Close File\tCtrl+W",         ID_FILE_CLOSEFILE
    END
    POPUP "&Play"
    BEGIN
        MENUITEM "&Play/Pause\tSpace",          ID_PLAY_PLAYPAUSE
        MENUITEM "&Stop\tPeriod",               ID_PLAY_STOP
        MENUITEM "Skip &Fwd\tRight",            ID_PLAY_SKIPFWD
        MENUITEM "Skip &Back\tLeft",            ID_PLAY_SKIPBACK
        MENUITEM SEPARATOR
        MENUITEM "F&aster Playback\tDown",      ID_PLAY_INCREASERATE
        MENUITEM "Sl&ower Playback\tUp",        ID_PLAY_DECREASERATE
        MENUITEM "&Reset\tR",                   ID_PLAY_RESETRATE
        MENUITEM SEPARATOR
        MENUITEM "Faster &Notes\tShift+Down",   ID_PLAY_NFASTER
        MENUITEM "Slower No&tes\tShift+Up",     ID_PLAY_NSLOWER
        MENUITEM SEPARATOR
        MENUITEM "&Volume Up\tAlt+Up",          ID_PLAY_VOLUMEUP
        MENUITEM "V&olume Down\tAlt+Down",      ID_PLAY_VOLUMEDOWN
        MENUITEM "&Mute\tM",                    ID_PLAY_MUTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Playback Toolbar\tCtrl+T",   ID_VIEW_CONTROLS, CHECKED
        MENUITEM "&Keyboard\tCtrl+K",           ID_VIEW_KEYBOARD, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "&Always On Top\tCtrl+A",      ID_VIEW_ALWAYSONTOP
        MENUITEM SEPARATOR
        MENUITEM "&Full Screen\tAlt+Enter",     ID_VIEW_FULLSCREEN
        MENUITEM "Mo&ve and Zoom\tCtrl+V",      ID_VIEW_MOVEANDZOOM
        MENUITEM "Reset Move and &Zoom\tCtrl+Z", ID_VIEW_RESETMOVEANDZOOM
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Preferences...\tCtrl+P",     ID_OPTIONS_PREFERENCES
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About PFAviz++...",          ID_HELP_ABOUT
    END
END

IDR_CONTEXTMENU MENU
BEGIN
    POPUP "Graphics"
    BEGIN
        POPUP "&File"
        BEGIN
            MENUITEM "&Play Song...\tCtrl+O",       ID_FILE_PLAYSONG
            MENUITEM "&Close File\tCtrl+W",         ID_FILE_CLOSEFILE
        END
        POPUP "&View"
        BEGIN
            MENUITEM "&Playback Toolbar\tCtrl+T",   ID_VIEW_CONTROLS, CHECKED
            MENUITEM "&Keyboard\tCtrl+K",           ID_VIEW_KEYBOARD, CHECKED
            MENUITEM SEPARATOR
            MENUITEM "&Always On Top\tCtrl+A",      ID_VIEW_ALWAYSONTOP
            MENUITEM SEPARATOR
            MENUITEM "&Full Screen\tAlt+Enter",     ID_VIEW_FULLSCREEN
            MENUITEM "Mo&ve and Zoom\tCtrl+V",      ID_VIEW_MOVEANDZOOM
            MENUITEM "Reset Move and &Zoom\tCtrl+Z", ID_VIEW_RESETMOVEANDZOOM
        END
        MENUITEM "Preferences...\tCtrl+P",      ID_OPTIONS_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "&Play/Pause\tSpace",          ID_PLAY_PLAYPAUSE
        MENUITEM "&Stop\tPeriod",               ID_PLAY_STOP
        MENUITEM "Skip &Fwd\tRight",            ID_PLAY_SKIPFWD
        MENUITEM "Skip &Back\tLeft",            ID_PLAY_SKIPBACK
        MENUITEM SEPARATOR
        MENUITEM "F&aster Playback\tDown",      ID_PLAY_INCREASERATE
        MENUITEM "Sl&ower Playback\tUp",        ID_PLAY_DECREASERATE
        MENUITEM "&Reset\tR",                   ID_PLAY_RESETRATE
        MENUITEM SEPARATOR
        MENUITEM "Faster &Notes\tShift+Down",   ID_PLAY_NFASTER
        MENUITEM "Slower No&tes\tShift+Up",     ID_PLAY_NSLOWER
        MENUITEM SEPARATOR
        MENUITEM "Volume &Up\tAlt+Up",          ID_PLAY_VOLUMEUP
        MENUITEM "Volume &Down\tAlt+Down",      ID_PLAY_VOLUMEDOWN
        MENUITEM "&Mute\tCtrl+M",               ID_PLAY_MUTE
    END
END

/////////////////////////////////////////////////////////////////////////////
// Accelerators

IDA_MAINMENU ACCELERATORS
BEGIN
    "W",            ID_FILE_CLOSEFILE,      VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_PLAYSONG,   VIRTKEY, CONTROL, NOINVERT
    "P",            ID_OPTIONS_PREFERENCES, VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_PLAY_INCREASERATE,   VIRTKEY, CONTROL, NOINVERT
    "M",            ID_PLAY_MUTE,           VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_PLAY_NFASTER,        VIRTKEY, SHIFT, NOINVERT
    "R",            ID_PLAY_NRESET,         VIRTKEY, SHIFT, NOINVERT
    VK_UP,          ID_PLAY_NSLOWER,        VIRTKEY, SHIFT, NOINVERT
    VK_SPACE,       ID_PLAY_PLAYPAUSE,      VIRTKEY, CONTROL, NOINVERT
    "R",            ID_PLAY_RESETRATE,      VIRTKEY, CONTROL, NOINVERT
    VK_LEFT,        ID_PLAY_SKIPBACK,       VIRTKEY, CONTROL, NOINVERT
    VK_RIGHT,       ID_PLAY_SKIPFWD,        VIRTKEY, CONTROL, NOINVERT
    VK_UP,          ID_PLAY_DECREASERATE,   VIRTKEY, CONTROL, NOINVERT
    VK_OEM_PERIOD,  ID_PLAY_STOP,           VIRTKEY, CONTROL, NOINVERT
    VK_DOWN,        ID_PLAY_VOLUMEDOWN,     VIRTKEY, ALT, NOINVERT
    VK_UP,          ID_PLAY_VOLUMEUP,       VIRTKEY, ALT, NOINVERT
    "A",            ID_VIEW_ALWAYSONTOP,    VIRTKEY, CONTROL, NOINVERT
    "T",            ID_VIEW_CONTROLS,       VIRTKEY, CONTROL, NOINVERT
    VK_RETURN,      ID_VIEW_FULLSCREEN,     VIRTKEY, ALT, NOINVERT
    "K",            ID_VIEW_KEYBOARD,       VIRTKEY, CONTROL, NOINVERT
    "V",            ID_VIEW_MOVEANDZOOM,    VIRTKEY, CONTROL, NOINVERT
    VK_ESCAPE,      ID_VIEW_NOFULLSCREEN,   VIRTKEY, NOINVERT
    "Z",            ID_VIEW_RESETMOVEANDZOOM, VIRTKEY, CONTROL, NOINVERT
END

/////////////////////////////////////////////////////////////////////////////
// Bitmaps, icons, splash song

IDB_MEDIAICONSSMALL     BITMAP                  "Images/mediaiconssmall.bmp"
IDB_SPLASH              BITMAP                  "Images/Mirror Small.bmp"
IDI_PFAICON             ICON                    "Images/PFA Icon.ico"
IDI_WELCOME             ICON                    "Images/Welcome.ico"
IDR_SPLASHMIDI          MIDI                    "Images/Godowsky - Study of Chopin Etude Op. 10, No. 1.mid"

/////////////////////////////////////////////////////////////////////////////
// Version

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "PFAviz++"
            VALUE "ProductName", "PFAviz++"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
            VALUE "OriginalFilename", "PFAviz++.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
